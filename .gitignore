# --- tcprawuplug (VS Code extension; details in tcprawuplug/.gitignore) ---
tcprawuplug/node_modules/
tcprawuplug/out/
tcprawuplug/dist/
tcprawuplug/*.vsix
tcprawuplug/.vscode-test/
tcprawuplug/.eslintcache
tcprawuplug/*.tsbuildinfo

# If tcprawuplug was ever `git init` on its own, ignore inner metadata so the
# parent repo tracks source files instead of a gitlink submodule.
tcprawuplug/.git/

# Same for legacy rawuploader/ tree (avoid nested-repo gitlink on GitHub).
rawuploader/.git/

# --- Go (manual / local CI-style builds in src/) ---
src/tcpraw
src/tcpraw.exe
src/tcpraw-linux-amd64
src/tcpraw-windows-amd64.exe
src/tcpraw_*_amd64.deb
rawuploader/src/tcpraw
rawuploader/src/tcpraw.exe

# --- OS / editor ---
.DS_Store
Thumbs.db
