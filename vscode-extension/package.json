{
  "name": "tcpraw-upload",
  "displayName": "tcpraw Upload",
  "description": "Upload files via tcpraw from the Explorer context menu; download code appears in the status bar.",
  "version": "0.1.0",
  "publisher": "hdmain",
  "repository": {
    "type": "git",
    "url": "https://github.com/hdmain/rawuploader.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tcpraw.upload"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tcpraw.upload",
        "title": "Upload with tcpraw"
      },
      {
        "command": "tcpraw.copyCode",
        "title": "Copy tcpraw download code"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tcpraw.upload",
          "group": "navigation@100",
          "when": "resourceScheme == file"
        }
      ],
      "editor/title/context": [
        {
          "command": "tcpraw.upload",
          "group": "navigation@100",
          "when": "resourceScheme == file"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
